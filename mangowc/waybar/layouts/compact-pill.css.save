/* Layout: compact-pill */

* {
    border: none;
    border-radius: 0;
    font-family: "Inter", monospace;
    font-size: 13px;
    min-height: 0;
}

window#waybar {
    background: @bar_bg;
    color: @bar_fg;
}

tooltip {
    background-color: @bar_bg;
    border: 1px solid @border_color;
    border-radius: 12px;
}

tooltip label {
    color: @bar_fg;
    text-shadow: none;
}

/* --- Modules: Base --- */
#custom-layout,
#custom-colorcycle,
#custom-tray-menu,
#user,
#clock,
#network,
#custom-updater,
#custom-menu,
#privacy,
#ext-workspaces,
#backlight,
#pulseaudio,
#cpu,
#battery,
#custom-clip,
#custom-notifications,
#cava,
#inhibitor,
#custom-snip,
#bluetooth,
#wireplumber.microphone,
#memory,
#disk,
#hyprland-window,
#custom-theme-switcher,
#mpris,
#workspaces,
#tray,
#mango-workspaces,
#custom-hyprlock,
#power-profiles-daemon,
#idle_inhibitor,
#custom-notification,
#custom-power,
#custom-launcher {
    background: @module_bg;
    color: @module_fg;
    padding: 3px 13px;
    margin: 4px 0px 4px 0px;
    border-radius: 0px;
    transition: all 0.3s ease;
}

#custom-launcher {
    color: @launcher;
    margin-left: 2px;
    border-radius: 99px 0px 0px 99px;
}

#custom-countdown {
    border-radius: 99px 0px 0px 99px;
}

#custom-todo {
    border-radius: 0px 99px 99px 0px;
}

#custom-power {
    background: @module_bg;
    color: @power;
    margin-right: 2px;
    border-radius: 0px 99px 99px 0px;
}

#keyboard-state {
    background: transparent;
}

#keyboard-state label.locked {
    background: @special;
    color: @module_fg; 
    padding: 0px 12px;
    margin: 4px 4px 4px 0px;	
    border-radius: 99px;
}

#network.disconnected,
#network.disabled {
    color: @power; 
}

/* --- Hover Effects --- */
#custom-launcher:hover,
#custom-layout:hover,
#custom-colorcycle:hover,
#tray:hover,
#custom-tray-menu:hover,
#clock:hover,
#disk:hover,
#custom-notifications:hover,
#mpris:hover,
#privacy:hover,
#network:hover,
#backlight:hover,
#pulseaudio:hover,
#battery:hover,
#memory:hover,
#user:hover,
#custom-menu:hover,
#wireplumber.microphone:hover,
#custom-clip:hover,
#cava:hover,
#custom-snip:hover,
#inhibitor:hover,
#cpu:hover,
#custom-updater:hover,
#custom-theme-switcher:hover,
#idle_inhibitor:hover,
#ext-workspaces:hover,
#bluetooth:hover,
#power-profiles-daemon:hover,
#custom-notification:hover,
#custom-music:hover,
#custom-thunar:hover {
    background: @hover_bg;
    color: @hover_fg;
}

#custom-launcher:hover {
    background: @hover_bg;
    color: @hover_fg;
}

#custom-power:hover {
    background: @power;
    color: @bar_bg;
}

#ext-workspaces button {
    color: @module_fg;
}

#ext-workspaces button.active {
    color: @power;
}
