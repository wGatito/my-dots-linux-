# Aparência e Janela
background-opacity = 0.9
window-padding-x = 5
window-padding-y = 5
confirm-close-surface = false

# Shell padrão
command = fish

# Fonte
font-family = JetBrainsMono Nerd Font
font-size = 11

# Tema Pywal (requer template adaptado, veja abaixo)
theme = ~/.cache/wal/colors-ghostty
